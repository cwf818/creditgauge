{
  "name": "creditgauge",
  "version": "1.1.8",
  "description": "Claude Code statusline plugin (CreditGauge) for MiniMax/DeepSeek token-plan usage and account balance. Ships an `npx creditgauge` TUI for install/uninstall/clean/diagnostics.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "creditgauge": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "scripts",
    ".claude-plugin",
    "commands",
    "query_plugins",
    "docs",
    "README.md",
    "MANUAL.md",
    "快速上手指南.md",
    "HOW_TO_CREATE_A_PLUGIN.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "npm run build:entry && npm run build:plugins",
    "build:entry": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/index.js",
    "build:plugins": "node scripts/copy-builtin-plugins.mjs",
    "dev": "npm run build:entry -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/**/*.test.ts",
    "settings:install": "bash scripts/install.sh",
    "settings:install:project": "bash scripts/install.sh --project",
    "settings:restore": "bash scripts/install.sh --restore",
    "settings:clean": "bash scripts/clean.sh",
    "settings:clean:dry": "bash scripts/clean.sh --dry-run",
    "settings:clean-cache": "bash scripts/clean-cache.sh",
    "settings:clean-cache:dry": "bash scripts/clean-cache.sh --dry-run",
    "scripts:test": "bash scripts/test-edit-settings.sh",
    "scripts:test:install": "bash scripts/test-install.sh",
    "scripts:test:clean-cache": "bash scripts/test-clean-cache.sh",
    "scripts:test:reset": "bash scripts/test-reset.sh",
    "scripts:test:rename": "bash scripts/test-rename-consistency.sh",
    "dev:uninstall": "bash scripts/dev-uninstall.sh",
    "dev:uninstall:dry": "bash scripts/dev-uninstall.sh --dry-run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  }
}
